// Hàm xử lý chính
void xuLyLenhXit(string maLenh, int viTriSlot, int thoiGianXitMs, long thoiHanLenh) {

    // 1. Chống xịt trùng
    if (daTuongChayLenh(maLenh)) {
        guiPhanHoiCapTren(maLenh, "DA_XIT_TROI", "Lenh nay da duoc thuc thi truoc do.");
        return;
    }

    // 2. Kiểm tra thời hạn
    if (layThoiGianHienTai() > thoiHanLenh) {
        guiPhanHoiCapTren(maLenh, "QUAN_THOI_HAN", "Lenh da het han do su co mang.");
        return;
    }

    // 3. Kiểm tra an toàn
    if (kiemTraCuaDangMo()) {
        guiPhanHoiCapTren(maLenh, "LOI_AN_TOAN", "Cua may dang mo, khong the xit.");
        return;
    }

    // 4. Tiến hành xịt
    luuMaLenhDaChay(maLenh);
    guiPhanHoiCapTren(maLenh, "DANG_XIT", "May bat dau kich hoat van.");

    batVanXit(viTriSlot);
    tatVanXit(viTriSlot);

    // 5. Báo cáo hoàn tất
    guiPhanHoiCapTren(maLenh, "THANH_CONG", "Da xit xong an toan.");
}

